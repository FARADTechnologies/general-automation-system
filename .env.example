# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Ports
CORE_BANK_PORT=4100
BRIDGE_PORT=4200
AGENT_PORT=4300
WEB_PORT=5173

# Service credentials (any long random strings for local dev)
CORE_BANK_SERVICE_KEY=
BRIDGE_AGENT_KEY=
BRIDGE_ADMIN_KEY=
BRIDGE_WEBHOOK_SECRET=

# Wiring. The agent knows only the bridge; the bridge knows core bank and the agent webhook.
CORE_BANK_URL=http://127.0.0.1:4100
BRIDGE_URL=http://127.0.0.1:4200
AGENT_WEBHOOK_URL=http://127.0.0.1:4300/hooks/bridge

# Optional
STT_PROVIDER=browser
SESSION_CALL_CAP=40
SESSION_SPEND_CAP_USD=1.50
