# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Ports
CORE_BANK_PORT=4100
BRIDGE_PORT=4200
AGENT_PORT=4300
WEB_PORT=5173

# Service credentials (any long random strings for local dev)
CORE_BANK_SERVICE_KEY=
BRIDGE_AGENT_KEY=
BRIDGE_ADMIN_KEY=
BRIDGE_WEBHOOK_SECRET=

# Wiring. The agent knows only the bridge; the bridge knows core bank and the agent webhook.
CORE_BANK_URL=http://127.0.0.1:4100
BRIDGE_URL=http://127.0.0.1:4200
AGENT_WEBHOOK_URL=http://127.0.0.1:4300/hooks/bridge

# Optional
STT_PROVIDER=browser
SESSION_CALL_CAP=40
SESSION_SPEND_CAP_USD=1.50

# Operator passcode for /console (bank side)
BRIDGE_CONSOLE_PASSCODE=

# Model provider: anthropic (default) or gemini
AGENT_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Server speech-to-text for push-to-talk (optional; without keys the app uses browser speech)
# Primary ElevenLabs Scribe v2, fallback Groq Whisper large-v3, 2.5 s deadline each
STT_PRIMARY=scribe
STT_FALLBACK=whisper
STT_TIMEOUT_MS=2500
ELEVENLABS_API_KEY=
GROQ_API_KEY=

# OpenAI-compatible providers (AGENT_PROVIDER=mistral | groq | openai-compat)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
