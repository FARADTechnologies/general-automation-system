{
  "name": "general-automation-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:core-bank": "pnpm --filter @gas/core-bank dev",
    "dev:bridge": "pnpm --filter @gas/bridge dev",
    "dev:agent": "pnpm --filter @gas/agent dev",
    "dev:web": "pnpm --filter @gas/web dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
